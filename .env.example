# ============================================================
# 运行时底座配置（变量名沿用共享集群，不另起一套）
# 复制本文件为 .env 即可；不填任何 Key 时请显式设 LLM_PROVIDER=mock
# ============================================================

# ---------- 选厂商：只改这一个变量，业务代码零改动 ----------
# dashscope（阿里云百炼）| deepseek | openai | ollama（本地）| mock（离线，不需要 Key）
# LLM_PROVIDER=dashscope
# LLM_API_KEY=sk-你的key
#
# deepseek 不支持 JSON 模式，网关会自动降级到容错解析，不用改配置。

# ---------- 离线演示（不需要任何 Key、不联网）----------
LLM_PROVIDER=mock
VECTOR_BACKEND=lexical

# ---------- 模型（不填则用厂商 preset 的默认值）----------
# MODEL_LIGHT=qwen-plus
# MODEL_HEAVY=qwen-max
# MODEL_EMBEDDING=text-embedding-v3

# ---------- 检索 ----------
# VECTOR_BACKEND=chroma          # chroma | numpy | lexical
# TOP_K=4
# CHUNK_SIZE=600
# CHUNK_OVERLAP=50
# RERANK_ALPHA=0.7

# ---------- 运行时底座自己的配置 ----------
# DOCS_DIR=./data/docs           # 目录约定：<DOCS_DIR>/<业务域>/*.md
# VECTOR_DIR=./vector_store
# TRACE_DIR=./var/traces
# MAX_ITERATIONS=6               # 单次 Agent 循环上限；同时是"撞上限"这个失败模式的判据

# ---------- 观测 ----------
# LOG_LEVEL=INFO
