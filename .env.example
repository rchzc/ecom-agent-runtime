# ============================================================
# 云端模型配置（openai-compatible 统一接入）
# 复制本文件为 .env 并填入你的 API_KEY 即可「可投入使用」
# 三家任选其一，只改 API_BASE / API_KEY / 模型名即可，业务代码不动
# ============================================================

# ---------- 方案A：DeepSeek（默认，便宜好用）----------
# API_BASE=https://api.deepseek.com/v1
# API_KEY=sk-你的deepseek_key
# LIGHT_MODEL=deepseek-chat
# HEAVY_MODEL=deepseek-reasoner

# ---------- 方案B：阿里云百炼（embedding 强）----------
# API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# API_KEY=sk-你的百炼key
# LIGHT_MODEL=qwen-plus
# HEAVY_MODEL=qwen-max
# EMBED_MODEL=text-embedding-v3

# ---------- 方案C：OpenAI ----------
# API_BASE=https://api.openai.com/v1
# API_KEY=sk-你的openai_key
# LIGHT_MODEL=gpt-4o-mini
# HEAVY_MODEL=gpt-4o
# EMBED_MODEL=text-embedding-3-small

# ===== 以下是本项目默认（未填 API_KEY 时自动降级 MOCK 演示）=====
LLM_PROVIDER=openai-compatible
LIGHT_MODEL=deepseek-chat
HEAVY_MODEL=deepseek-reasoner
EMBED_MODEL=text-embedding-v3

# ===== 存储 =====
VECTOR_DIR=./vector_store
DOCS_DIR=./data/docs
COLLECTION=presale_kb

# ===== 双模开关（默认走真模型；无 key 自动 MOCK）=====
MOCK_LLM=false
MOCK_EMBED=false
